<UserControl x:Class="GameNotes.UI.TableGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Border BorderBrush="#55808080" BorderThickness="1" Margin="4" Padding="2"
            Background="{DynamicResource NormalBackgroundBrush}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="2">
                <Button Content="+ Row" Padding="6,2" Margin="0,0,4,0" Click="OnAddRowClick"/>
                <Button Content="+ Column" Padding="6,2" Margin="0,0,4,0" Click="OnAddColumnClick"/>
                <Button Content="− Row" Padding="6,2" Margin="0,0,4,0" Click="OnRemoveRowClick"/>
                <Button Content="− Column" Padding="6,2" Click="OnRemoveColumnClick"/>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxWidth="900">
                <Grid x:Name="CellsGrid" />
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
