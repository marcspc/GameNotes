<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Playnite (desktop) runs on .NET Framework 4.6.2, so the plugin must
         target the same framework to stay compatible. -->
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GameNotes</AssemblyName>
    <RootNamespace>GameNotes</RootNamespace>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official Playnite package, restored from NuGet.org. -->
    <PackageReference Include="PlayniteSDK" Version="6.17.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
